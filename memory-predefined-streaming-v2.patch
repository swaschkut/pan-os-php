+            if( $reader->nodeType == XMLReader::ELEMENT && $reader->depth == $parentDepth + 1 && $reader->name == $name )
+                return TRUE;
+            if( !$reader->next() )
+                return FALSE;
+        }
+        return FALSE;
+    }
