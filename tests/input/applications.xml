<?xml version="1.0"?>
<config version="11.1.0" urldb="paloaltonetworks">
  <mgt-config><users/></mgt-config>
  <shared/>
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <application>
            <entry name="app-custom">
              <default><port><member>tcp/8080</member></port></default>
              <category>business-systems</category>
              <subcategory>database</subcategory>
              <technology>client-server</technology>
              <description>synthetic test application</description>
              <timeout>3600</timeout>
              <risk>2</risk>
            </entry>
            <entry name="app-proto">
              <default><ident-by-ip-protocol>99</ident-by-ip-protocol></default>
              <category>networking</category>
              <subcategory>ip-protocol</subcategory>
              <technology>network-protocol</technology>
              <risk>1</risk>
            </entry>
          </application>
          <application-group>
            <entry name="ag-1"><members><member>app-custom</member><member>ssl</member></members></entry>
          </application-group>
          <application-filter>
            <entry name="af-1">
              <category><member>networking</member></category>
              <risk><member>5</member></risk>
              <evasive>yes</evasive>
            </entry>
          </application-filter>
          <rulebase>
            <security>
              <rules>
                <entry name="r-app">
                  <from><member>any</member></from><to><member>any</member></to>
                  <source><member>any</member></source><destination><member>any</member></destination>
                  <source-user><member>any</member></source-user><category><member>any</member></category>
                  <application><member>app-custom</member><member>af-1</member></application><service><member>application-default</member></service>
                  <action>allow</action>
                </entry>
                <entry name="r-group">
                  <from><member>any</member></from><to><member>any</member></to>
                  <source><member>any</member></source><destination><member>any</member></destination>
                  <source-user><member>any</member></source-user><category><member>any</member></category>
                  <application><member>ag-1</member></application><service><member>application-default</member></service>
                  <action>allow</action>
                </entry>
              </rules>
            </security>
          </rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
