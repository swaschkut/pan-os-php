<?xml version="1.0"?>
<config version="11.1.0" urldb="paloaltonetworks">
  <mgt-config>
    <devices>
      <entry name="SER1"/>
      <entry name="SER2"/>
      <entry name="SER3"/>
    </devices>
  </mgt-config>
  <shared>
    <address>
      <entry name="pub-web">
        <ip-netmask>198.51.100.10/32</ip-netmask>
      </entry>
      <entry name="pub-app">
        <ip-netmask>198.51.100.20/32</ip-netmask>
      </entry>
      <entry name="pub-ext">
        <ip-netmask>198.51.100.30/32</ip-netmask>
      </entry>
      <entry name="web-dmz">
        <ip-netmask>172.16.1.10/32</ip-netmask>
      </entry>
      <entry name="app-srv">
        <ip-netmask>10.20.5.10/32</ip-netmask>
      </entry>
      <entry name="ext-host">
        <ip-netmask>192.0.2.50/32</ip-netmask>
      </entry>
      <entry name="pub-web2">
        <ip-netmask>198.51.100.11/32</ip-netmask>
      </entry>
      <entry name="web-dmz2">
        <ip-netmask>172.16.1.11/32</ip-netmask>
      </entry>
      <entry name="pub-svc">
        <ip-netmask>198.51.100.60/32</ip-netmask>
      </entry>
      <entry name="pub-port">
        <ip-netmask>198.51.100.40/32</ip-netmask>
      </entry>
      <entry name="pub-pool">
        <ip-netmask>198.51.100.50/32</ip-netmask>
      </entry>
      <entry name="pool-range">
        <ip-range>172.16.1.20-172.16.1.21</ip-range>
      </entry>
      <entry name="pool-one">
        <ip-netmask>172.16.1.20/32</ip-netmask>
      </entry>
      <entry name="dmz-web-net">
        <ip-netmask>172.16.1.0/28</ip-netmask>
      </entry>
      <entry name="net-trust">
        <ip-netmask>10.1.0.0/24</ip-netmask>
      </entry>
      <entry name="partner">
        <ip-netmask>203.0.113.0/24</ip-netmask>
      </entry>
    </address>
    <service>
      <entry name="tcp-8443">
        <protocol>
          <tcp>
            <port>8443</port>
          </tcp>
        </protocol>
      </entry>
      <entry name="tcp-443">
        <protocol>
          <tcp>
            <port>443</port>
          </tcp>
        </protocol>
      </entry>
      <entry name="tcp-8000-9000">
        <protocol>
          <tcp>
            <port>8000-9000</port>
          </tcp>
        </protocol>
      </entry>
    </service>
  </shared>
  <devices>
    <entry name="localhost.localdomain">
      <template>
        <entry name="T-base">
          <variable>
            <entry name="$dmz-ip">
              <type>
                <ip-netmask>172.16.1.1/24</ip-netmask>
              </type>
            </entry>
          </variable>
          <config>
            <devices>
              <entry name="localhost.localdomain">
                <network>
                  <interface>
                    <ethernet>
                      <entry name="ethernet1/1">
                        <layer3>
                          <ip>
                            <entry name="198.51.100.1/24"/>
                          </ip>
                        </layer3>
                      </entry>
                      <entry name="ethernet1/2">
                        <layer3>
                          <ip>
                            <entry name="10.1.0.1/24"/>
                          </ip>
                        </layer3>
                      </entry>
                      <entry name="ethernet1/3">
                        <layer3>
                          <ip>
                            <entry name="$dmz-ip"/>
                          </ip>
                        </layer3>
                      </entry>
                      <entry name="ethernet1/4">
                        <layer3>
                          <ip>
                            <entry name="10.2.255.1/30"/>
                          </ip>
                        </layer3>
                      </entry>
                    </ethernet>
                  </interface>
                  <virtual-router>
                    <entry name="vr-1">
                      <interface>
                        <member>ethernet1/1</member>
                        <member>ethernet1/2</member>
                        <member>ethernet1/3</member>
                        <member>ethernet1/4</member>
                      </interface>
                      <routing-table>
                        <ip>
                          <static-route>
                            <entry name="to-srv">
                              <destination>10.20.0.0/16</destination>
                              <nexthop>
                                <ip-address>10.2.255.2</ip-address>
                              </nexthop>
                              <interface>ethernet1/4</interface>
                              <metric>10</metric>
                            </entry>
                            <entry name="default">
                              <destination>0.0.0.0/0</destination>
                              <nexthop>
                                <ip-address>198.51.100.254</ip-address>
                              </nexthop>
                              <interface>ethernet1/1</interface>
                              <metric>10</metric>
                            </entry>
                          </static-route>
                        </ip>
                      </routing-table>
                    </entry>
                  </virtual-router>
                </network>
                <vsys>
                  <entry name="vsys1">
                    <import>
                      <network>
                        <interface>
                          <member>ethernet1/1</member>
                          <member>ethernet1/2</member>
                          <member>ethernet1/3</member>
                          <member>ethernet1/4</member>
                        </interface>
                      </network>
                    </import>
                  </entry>
                </vsys>
              </entry>
            </devices>
          </config>
        </entry>
        <entry name="T-A">
          <config>
            <devices>
              <entry name="localhost.localdomain">
                <vsys>
                  <entry name="vsys1">
                    <zone>
                      <entry name="untrust">
                        <network>
                          <layer3>
                            <member>ethernet1/1</member>
                          </layer3>
                        </network>
                      </entry>
                      <entry name="trust">
                        <network>
                          <layer3>
                            <member>ethernet1/2</member>
                          </layer3>
                        </network>
                      </entry>
                      <entry name="dmz">
                        <network>
                          <layer3>
                            <member>ethernet1/3</member>
                          </layer3>
                        </network>
                      </entry>
                      <entry name="srv">
                        <network>
                          <layer3>
                            <member>ethernet1/4</member>
                          </layer3>
                        </network>
                      </entry>
                    </zone>
                  </entry>
                </vsys>
              </entry>
            </devices>
          </config>
        </entry>
        <entry name="T-B">
          <config>
            <devices>
              <entry name="localhost.localdomain">
                <vsys>
                  <entry name="vsys1">
                    <zone>
                      <entry name="untrust">
                        <network>
                          <layer3>
                            <member>ethernet1/1</member>
                          </layer3>
                        </network>
                      </entry>
                      <entry name="trust">
                        <network>
                          <layer3>
                            <member>ethernet1/2</member>
                          </layer3>
                        </network>
                      </entry>
                      <entry name="dmz">
                        <network>
                          <layer3>
                            <member>ethernet1/3</member>
                          </layer3>
                        </network>
                      </entry>
                      <entry name="srv-b">
                        <network>
                          <layer3>
                            <member>ethernet1/4</member>
                          </layer3>
                        </network>
                      </entry>
                    </zone>
                  </entry>
                </vsys>
              </entry>
            </devices>
          </config>
        </entry>
      </template>
      <template-stack>
        <entry name="TS-A">
          <templates>
            <member>T-A</member>
            <member>T-base</member>
          </templates>
          <devices>
            <entry name="SER1"/>
            <entry name="SER3"/>
          </devices>
        </entry>
        <entry name="TS-B">
          <templates>
            <member>T-B</member>
            <member>T-base</member>
          </templates>
          <devices>
            <entry name="SER2">
              <variable>
                <entry name="$dmz-ip">
                  <type>
                    <ip-netmask>172.31.0.1/24</ip-netmask>
                  </type>
                </entry>
              </variable>
            </entry>
          </devices>
        </entry>
      </template-stack>
      <device-group>
        <entry name="DG1">
          <devices>
            <entry name="SER1"/>
            <entry name="SER2"/>
          </devices>
          <pre-rulebase>
            <security>
              <rules>
                <entry name="deny-partner">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>dmz</member>
                  </to>
                  <source>
                    <member>partner</member>
                  </source>
                  <destination>
                    <member>pub-web</member>
                  </destination>
                  <source-user>
                    <member>any</member>
                  </source-user>
                  <category>
                    <member>any</member>
                  </category>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>deny</action>
                </entry>
                <entry name="wrong-post-nat-ip">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>dmz</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>web-dmz</member>
                  </destination>
                  <source-user>
                    <member>any</member>
                  </source-user>
                  <category>
                    <member>any</member>
                  </category>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>allow</action>
                </entry>
                <entry name="allow-web">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>dmz</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>pub-web</member>
                  </destination>
                  <source-user>
                    <member>any</member>
                  </source-user>
                  <category>
                    <member>any</member>
                  </category>
                  <application>
                    <member>web-browsing</member>
                  </application>
                  <service>
                    <member>service-http</member>
                  </service>
                  <action>allow</action>
                </entry>
                <entry name="allow-dmz-any">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>dmz</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>pub-web</member>
                  </destination>
                  <source-user>
                    <member>any</member>
                  </source-user>
                  <category>
                    <member>any</member>
                  </category>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>allow</action>
                </entry>
                <entry name="allow-app">
                  <target>
                    <devices>
                      <entry name="SER1"/>
                    </devices>
                  </target>
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>srv</member>
                    <member>srv-b</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>pub-app</member>
                  </destination>
                  <source-user>
                    <member>any</member>
                  </source-user>
                  <category>
                    <member>any</member>
                  </category>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>tcp-8000-9000</member>
                  </service>
                  <action>allow</action>
                </entry>
                <entry name="disabled-ext">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>untrust</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>pub-ext</member>
                  </destination>
                  <source-user>
                    <member>any</member>
                  </source-user>
                  <category>
                    <member>any</member>
                  </category>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>allow</action>
                  <disabled>yes</disabled>
                </entry>
                <entry name="deny-ext">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>untrust</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>pub-ext</member>
                  </destination>
                  <source-user>
                    <member>any</member>
                  </source-user>
                  <category>
                    <member>any</member>
                  </category>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>deny</action>
                </entry>
                <entry name="allow-ext">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>untrust</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>pub-ext</member>
                  </destination>
                  <source-user>
                    <member>any</member>
                  </source-user>
                  <category>
                    <member>any</member>
                  </category>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>allow</action>
                </entry>
                <entry name="asa-partial">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>dmz</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>dmz-web-net</member>
                  </destination>
                  <source-user>
                    <member>any</member>
                  </source-user>
                  <category>
                    <member>any</member>
                  </category>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>service-http</member>
                  </service>
                  <action>allow</action>
                </entry>
                <entry name="fw-zone-svc">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>untrust</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>pub-svc</member>
                  </destination>
                  <source-user>
                    <member>any</member>
                  </source-user>
                  <category>
                    <member>any</member>
                  </category>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>tcp-8443</member>
                  </service>
                  <action>allow</action>
                </entry>
                <entry name="asa-port">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>srv</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>app-srv</member>
                  </destination>
                  <source-user>
                    <member>any</member>
                  </source-user>
                  <category>
                    <member>any</member>
                  </category>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>tcp-443</member>
                  </service>
                  <action>allow</action>
                </entry>
                <entry name="asa-pool-one">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>dmz</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>pool-one</member>
                  </destination>
                  <source-user>
                    <member>any</member>
                  </source-user>
                  <category>
                    <member>any</member>
                  </category>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>service-http</member>
                  </service>
                  <action>allow</action>
                </entry>
                <entry name="trust-to-web">
                  <from>
                    <member>trust</member>
                  </from>
                  <to>
                    <member>dmz</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>web-dmz</member>
                  </destination>
                  <source-user>
                    <member>any</member>
                  </source-user>
                  <category>
                    <member>any</member>
                  </category>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>allow</action>
                </entry>
                <entry name="allow-out">
                  <from>
                    <member>trust</member>
                  </from>
                  <to>
                    <member>untrust</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <source-user>
                    <member>any</member>
                  </source-user>
                  <category>
                    <member>any</member>
                  </category>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>application-default</member>
                  </service>
                  <action>allow</action>
                </entry>
                <entry name="allow-out-all">
                  <from>
                    <member>trust</member>
                  </from>
                  <to>
                    <member>untrust</member>
                  </to>
                  <source>
                    <member>net-trust</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <source-user>
                    <member>any</member>
                  </source-user>
                  <category>
                    <member>any</member>
                  </category>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>allow</action>
                </entry>
              </rules>
            </security>
            <nat>
              <rules>
                <entry name="dnat-web">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>untrust</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>pub-web</member>
                  </destination>
                  <service>service-http</service>
                  <destination-translation>
                    <translated-address>web-dmz</translated-address>
                  </destination-translation>
                </entry>
                <entry name="dnat-app">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>untrust</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>pub-app</member>
                  </destination>
                  <service>tcp-8443</service>
                  <destination-translation>
                    <translated-address>app-srv</translated-address>
                  </destination-translation>
                </entry>
                <entry name="dnat-ext">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>untrust</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>pub-ext</member>
                  </destination>
                  <service>any</service>
                  <destination-translation>
                    <translated-address>ext-host</translated-address>
                  </destination-translation>
                </entry>
                <entry name="dnat-web2">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>untrust</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>pub-web2</member>
                  </destination>
                  <service>service-http</service>
                  <destination-translation>
                    <translated-address>web-dmz2</translated-address>
                  </destination-translation>
                </entry>
                <entry name="dnat-svc">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>untrust</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>pub-svc</member>
                  </destination>
                  <service>tcp-8443</service>
                  <destination-translation>
                    <translated-address>app-srv</translated-address>
                  </destination-translation>
                </entry>
                <entry name="dnat-port">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>untrust</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>pub-port</member>
                  </destination>
                  <service>tcp-8443</service>
                  <destination-translation>
                    <translated-address>app-srv</translated-address>
                    <translated-port>443</translated-port>
                  </destination-translation>
                </entry>
                <entry name="dnat-pool">
                  <from>
                    <member>untrust</member>
                  </from>
                  <to>
                    <member>untrust</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>pub-pool</member>
                  </destination>
                  <service>service-http</service>
                  <destination-translation>
                    <translated-address>pool-range</translated-address>
                  </destination-translation>
                </entry>
                <entry name="snat-out">
                  <from>
                    <member>trust</member>
                  </from>
                  <to>
                    <member>untrust</member>
                  </to>
                  <source>
                    <member>net-trust</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <service>any</service>
                  <source-translation>
                    <dynamic-ip-and-port>
                      <interface-address>
                        <interface>ethernet1/1</interface>
                      </interface-address>
                    </dynamic-ip-and-port>
                  </source-translation>
                </entry>
                <entry name="bidir-web">
                  <from>
                    <member>dmz</member>
                  </from>
                  <to>
                    <member>untrust</member>
                  </to>
                  <source>
                    <member>web-dmz</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <service>any</service>
                  <source-translation>
                    <static-ip>
                      <translated-address>pub-web</translated-address>
                      <bi-directional>yes</bi-directional>
                    </static-ip>
                  </source-translation>
                </entry>
              </rules>
            </nat>
          </pre-rulebase>
        </entry>
        <entry name="DG1-child">
          <devices>
            <entry name="SER3"/>
          </devices>
        </entry>
      </device-group>
    </entry>
  </devices>
  <readonly>
    <devices>
      <entry name="localhost.localdomain">
        <device-group>
          <entry name="DG1">
            <id>11</id>
          </entry>
          <entry name="DG1-child">
            <id>12</id>
            <parent-dg>DG1</parent-dg>
          </entry>
        </device-group>
      </entry>
    </devices>
  </readonly>
</config>
