-    static public function convertLifeTime($input, $entero, &$output_unit, &$output_value)
-    {
-        $output_value = $input;
-        $output_unit = 1;
-        //Seconds
-        if( $output_value > 65535 )
-        {
-            $output_value = (int)$output_value / 60;
-            $output_unit++;
-        }
-        //Minutes
-        if( $output_value > 65535 )
-        {
-            $output_value = (int)$output_value / 60;
-            $output_unit++;
-        }
-        //Hours
-        if( $output_value > 65535 )
-        {
-            $output_value = (int)$output_value / 24;
-            $output_unit++;
-        }
-        //Days
-
-        switch ($output_unit)
-        {
-            case 1:
-                $output_unit = "seconds";
-                break;
-            case 2:
-                $output_unit = "minutes";
-                break;
-            case 3:
-                $output_unit = "hours";
-                break;
-            case 4:
-                $output_unit = "days";
-                break;
-            default:
-                $output_unit = "seconds";
-                break;
-        }
-
-        if( $entero )
-        {
-            $output_value = round($output_value);
-        }
-    }
