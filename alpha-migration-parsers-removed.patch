-	&PrintLog ("\n");
-	$svc_type{'any'} = 'any';
-	if ($FLAG_sortbytype) {
-		@svc_name2 = sort { $svc_type{"$a"} cmp $svc_type{"$b"} or lc($a) cmp lc($b) } @svc_name;
