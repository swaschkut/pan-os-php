-				$svc_src_high{$name} = $lineparam;
-			} elsif ( $line =~ /^\t\t\t:prematch \(/ ){
-				$svc_match{$name} = $lineparam;
-			} elsif ( $line =~ /^\t\t\t:prolog \(/ ){
-				$svc_prolog{$name} = $lineparam;
