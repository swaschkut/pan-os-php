diff --git a/utils/lib/SCMAPPLY.php b/utils/lib/SCMAPPLY.php
new file mode 100644
index 00000000..a4bae8de
--- /dev/null
+++ b/utils/lib/SCMAPPLY.php
@@ -0,0 +1,383 @@
+<?php
+/**
